# Port the web app listens on
PORT=3000

# Comma-separated premium keys. Anyone entering one of these on /upgrade gets premium.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
COFFER_PREMIUM_KEYS=change-me-premium-key

# Descriptive User-Agent the OSRS Wiki asks for. Put a way to contact you in it.
COFFER_USER_AGENT="coffer/0.1 (contact: you@example.com)"

# Refresh cadence in seconds. Premium is 10x faster than free by default.
COFFER_FREE_REFRESH_SECONDS=300
COFFER_PREMIUM_REFRESH_SECONDS=30

# Grand Exchange tax settings (2% capped at 5m per item as of 2025; adjust if Jagex changes it)
COFFER_GE_TAX_RATE=0.02
COFFER_GE_TAX_CAP=5000000

# Set to 1 to run on bundled fixture data with no network (used by tests)
COFFER_OFFLINE=0
